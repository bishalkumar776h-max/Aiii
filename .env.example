# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# MongoDB (use MongoDB Atlas free tier for production / Vercel)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai-premium-suite
MONGODB_URI=mongodb://127.0.0.1:27017/ai-premium-suite

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=aips_token

# First admin account (used by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_USERNAME=admin

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
